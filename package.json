{
  "name": "context-intellisense",
  "displayName": "ConTeXt IntelliSense",
  "description": "ConTeXt syntax highlighting plus context-aware completions with command signatures and key-value hints.",
  "version": "1.1.0",
  "publisher": "wdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/wdev95/context-intellisense.git"
  },
  "scripts": {
    "build-vsix": "node ./build-vsix.js",
    "install-vsix": "node ./install-vsix.js"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:context.tex"
  ],
  "main": "./extension.js",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "contextIntellisense.configureTexRootPath",
        "title": "ConTeXt IntelliSense: Configure TeX Root Path"
      },
      {
        "command": "contextIntellisense.configureMainFilePath",
        "title": "ConTeXt IntelliSense: Configure Main File"
      },
      {
        "command": "contextIntellisense.setMainFileFromExplorer",
        "title": "ConTeXt IntelliSense: Set as Main File"
      },
      {
        "command": "contextIntellisense.compileCurrentFile",
        "title": "Compile Current",
        "icon": "$(play)"
      },
      {
        "command": "contextIntellisense.compileMainFile",
        "title": "Compile Main",
        "icon": "$(run-all)"
      },
      {
        "command": "contextIntellisense.showPdfForCurrentFile",
        "title": "Show PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "contextIntellisense.clearWorkspace",
        "title": "Clear Workspace",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "contextIntellisense.setMainFileFromExplorer",
          "group": "navigation@10",
          "when": "resourceScheme == file && (resourceExtname == .tex || resourceExtname == .mkiv || resourceExtname == .mkxl || resourceExtname == .mkvi || resourceExtname == .mkil || resourceExtname == .mkix || resourceExtname == .mkxi || resourceExtname == .mklx)"
        }
      ],
      "editor/title": [
        {
          "command": "contextIntellisense.compileCurrentFile",
          "group": "navigation@10",
          "when": "resourceScheme == file && resourceLangId == context.tex"
        },
        {
          "command": "contextIntellisense.compileMainFile",
          "group": "navigation@11",
          "when": "resourceScheme == file && resourceLangId == context.tex"
        },
        {
          "command": "contextIntellisense.showPdfForCurrentFile",
          "group": "navigation@12",
          "when": "resourceScheme == file && resourceLangId == context.tex"
        },
        {
          "command": "contextIntellisense.clearWorkspace",
          "group": "navigation@13",
          "when": "resourceScheme == file && resourceLangId == context.tex"
        }
      ]
    },
    "languages": [
      {
        "id": "context.tex",
        "aliases": [
          "ConTeXt TEX"
        ],
        "extensions": [
          ".mkil",
          ".mkiv",
          ".mkix",
          ".mklx",
          ".mkvi",
          ".mkxi",
          ".mkxl",
          ".tex"
        ],
        "configuration": "./settings/context-settings-tex.json"
      },
      {
        "id": "context.mps",
        "aliases": [
          "ConTeXt MetaFun"
        ],
        "extensions": [
          ".mp",
          ".mpii",
          ".mpiv",
          ".mpxl"
        ],
        "configuration": "./settings/context-settings-mps.json"
      },
      {
        "id": "context.lua",
        "aliases": [
          "ConTeXt Lua"
        ],
        "configuration": "./settings/context-settings-lua.json"
      },
      {
        "id": "context.cld",
        "aliases": [
          "ConTeXt CLD"
        ],
        "extensions": [
          ".cld",
          ".lfg",
          ".lmt",
          ".lua",
          ".luc",
          ".lui",
          ".luj",
          ".lum",
          ".luv",
          ".tma",
          ".tuc"
        ],
        "configuration": "./settings/context-settings-cld.json"
      },
      {
        "id": "context.xml",
        "aliases": [
          "ConTeXt XML"
        ],
        "extensions": [
          ".ctx",
          ".dtd",
          ".exa",
          ".export",
          ".fo",
          ".htm",
          ".html",
          ".lmx",
          ".rlb",
          ".rlg",
          ".rlv",
          ".rng",
          ".svg",
          ".xfdf",
          ".xhtml",
          ".xml",
          ".xsd",
          ".xsl",
          ".xslt",
          ".xul"
        ],
        "configuration": "./settings/context-settings-xml.json"
      },
      {
        "id": "context.bibtex",
        "aliases": [
          "ConTeXt bibTeX"
        ],
        "extensions": [
          ".bib",
          ".btx"
        ],
        "configuration": "./settings/context-settings-bibtex.json"
      },
      {
        "id": "context.sql",
        "aliases": [
          "ConTeXt SQL"
        ],
        "extensions": [
          ".sql"
        ],
        "configuration": "./settings/context-settings-sql.json"
      },
      {
        "id": "context.bnf",
        "aliases": [
          "ConTeXt BNF"
        ],
        "extensions": [
          ".bnf"
        ],
        "configuration": "./settings/context-settings-bnf.json"
      },
      {
        "id": "context.cpp",
        "aliases": [
          "ConTeXt C"
        ],
        "extensions": [
          ".c",
          ".cpp",
          ".h",
          ".hpp"
        ],
        "configuration": "./settings/context-settings-cpp.json"
      },
      {
        "id": "context.pdf",
        "aliases": [
          "ConTeXt PDF"
        ],
        "extensions": [
          ".pdf"
        ],
        "configuration": "./settings/context-settings-pdf.json"
      },
      {
        "id": "context.json",
        "aliases": [
          "ConTeXt JSON"
        ],
        "extensions": [
          ".json"
        ],
        "configuration": "./settings/context-settings-json.json"
      }
    ],
    "grammars": [
      {
        "language": "context.tex",
        "scopeName": "source.context.tex",
        "path": "./syntaxes/context-syntax-tex.json"
      },
      {
        "language": "context.mps",
        "scopeName": "source.context.mps",
        "path": "./syntaxes/context-syntax-mps.json"
      },
      {
        "language": "context.lua",
        "scopeName": "source.context.lua",
        "path": "./syntaxes/context-syntax-lua.json"
      },
      {
        "language": "context.cld",
        "scopeName": "source.context.cld",
        "path": "./syntaxes/context-syntax-cld.json"
      },
      {
        "language": "context.xml",
        "scopeName": "source.context.xml",
        "path": "./syntaxes/context-syntax-xml.json"
      },
      {
        "language": "context.bibtex",
        "scopeName": "source.context.bibtex",
        "path": "./syntaxes/context-syntax-bibtex.json"
      },
      {
        "language": "context.sql",
        "scopeName": "source.context.sql",
        "path": "./syntaxes/context-syntax-sql.json"
      },
      {
        "language": "context.bnf",
        "scopeName": "source.context.bnf",
        "path": "./syntaxes/context-syntax-bnf.json"
      },
      {
        "language": "context.cpp",
        "scopeName": "source.context.cpp",
        "path": "./syntaxes/context-syntax-cpp.json"
      },
      {
        "language": "context.pdf",
        "scopeName": "source.context.pdf",
        "path": "./syntaxes/context-syntax-pdf.json"
      },
      {
        "language": "context.json",
        "scopeName": "source.context.json",
        "path": "./syntaxes/context-syntax-json.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.tex": "context.tex",
        "*.mkil": "context.tex",
        "*.mkiv": "context.tex",
        "*.mkix": "context.tex",
        "*.mklx": "context.tex",
        "*.mkvi": "context.tex",
        "*.mkxi": "context.tex",
        "*.mkxl": "context.tex",
        "*.lua": "context.lua",
        "*.cld": "context.cld",
        "*.tuc": "context.cld"
      },
      "github.copilot.enable": {
        "*": false,
        "context.tex": false,
        "context.mps": false,
        "context.lua": false,
        "context.cld": false,
        "context.xml": false,
        "context.bibtex": false,
        "context.sql": false,
        "context.bnf": false,
        "context.cpp": false,
        "context.pdf": false,
        "context.json": false
      },
      "[context.tex]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.quickSuggestionsDelay": 0,
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.showWords": false,
        "editor.snippetSuggestions": "none",
        "editor.suggest.showSnippets": false,
        "editor.inlineSuggest.enabled": false,
        "editor.tabCompletion": "on",
        "editor.suggest.snippetsPreventQuickSuggestions": false
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "context.comment"
            ],
            "settings": {
              "foreground": "#8A8A00"
            }
          },
          {
            "scope": [
              "context.command",
              "context.primitive",
              "context.helper"
            ],
            "settings": {
              "foreground": "#008000",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "context.constant",
              "context.reserved"
            ],
            "settings": {
              "foreground": "#007A7A"
            }
          },
          {
            "scope": [
              "context.grouping",
              "context.special"
            ],
            "settings": {
              "foreground": "#005A9C"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "ConTeXt IntelliSense",
      "properties": {
        "contextIntellisense.texRootPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the root of your ConTeXt / TeX installation. The extension finds context-en.xml and the context executable automatically below this folder."
        },
        "contextIntellisense.mainFilePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the project main .tex file that should be compiled from the main-file command."
        },
        "contextIntellisense.copilotDisableMode": {
          "type": "string",
          "enum": [
            "global",
            "context-only",
            "off"
          ],
          "default": "global",
          "markdownDescription": "Controls how this extension enforces Copilot disabling: `global` disables Copilot everywhere, `context-only` disables it for ConTeXt language IDs, `off` does not enforce changes."
        }
      }
    }
  },
  "license": "MIT"
}
