{
 "name" : "context.bibtex",
 "patterns" : [
  {
   "include" : "#forget"
  },
  {
   "include" : "#comment"
  },
  {
   "include" : "#shortcut"
  },
  {
   "include" : "#definition"
  }
 ],
 "repository" : {
  "comment" : {
   "begin" : "\u005Cs*(@(?:comment|Comment|COMMENT))\u005Cs*\u005Cs*({)\u005Cs*",
   "beginCaptures" : {
    "1" : {
     "name" : "keyword.comment.name.bibtex"
    },
    "2" : {
     "name" : "punctuation.definition.comment.open.bibtex"
    }
   },
   "end" : "\u005Cs*(})\u005Cs*",
   "endCaptures" : {
    "1" : {
     "name" : "punctuation.definition.comment.close.bibtex"
    }
   },
   "name" : "comment.comment.comment.content.bibtex"
  },
  "concatinator" : {
   "match" : "\u005Cs*(#)\u005Cs*",
   "name" : "keyword.operator.definition.concatinator.bibtex"
  },
  "definition" : {
   "begin" : "\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*\u005Cs*({)\u005Cs*\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*\u005Cs*(,)\u005Cs*",
   "beginCaptures" : {
    "1" : {
     "name" : "keyword.definition.category.bibtex"
    },
    "2" : {
     "name" : "punctuation.definition.definition.open.bibtex"
    },
    "3" : {
     "name" : "keyword.operator.definition.label.separator.bibtex"
    }
   },
   "end" : "\u005Cs*(})\u005Cs*",
   "endCaptures" : {
    "1" : {
     "name" : "punctuation.definition.definition.close.bibtex"
    }
   },
   "name" : "invalid.definition.error.bibtex",
   "patterns" : [
    {
     "include" : "#string_double"
    },
    {
     "include" : "#string_single"
    },
    {
     "include" : "#string_grouped"
    },
    {
     "include" : "#string_value"
    },
    {
     "include" : "#string_concat"
    },
    {
     "include" : "#separator"
    }
   ]
  },
  "forget" : {
   "match" : "%.*$\u005Cn?",
   "name" : "comment.comment.comment.inline.bibtex"
  },
  "separator" : {
   "match" : "\u005Cs*(,)\u005Cs*",
   "name" : "keyword.operator.definition.separator.bibtex"
  },
  "shortcut" : {
   "begin" : "\u005Cs*(@(?:string|String|STRING))\u005Cs*\u005Cs*({)\u005Cs*",
   "beginCaptures" : {
    "1" : {
     "name" : "keyword.shortcut.name.bibtex"
    },
    "2" : {
     "name" : "punctuation.definition.shortcut.open.bibtex"
    }
   },
   "end" : "\u005Cs*(})\u005Cs*",
   "endCaptures" : {
    "1" : {
     "name" : "punctuation.definition.shortcut.close.bibtex"
    }
   },
   "name" : "invalid.shortcut.error.bibtex",
   "patterns" : [
    {
     "include" : "#string_double"
    },
    {
     "include" : "#string_single"
    },
    {
     "include" : "#string_grouped"
    },
    {
     "include" : "#string_value"
    },
    {
     "include" : "#string_concat"
    }
   ]
  },
  "string_concat" : {
   "patterns" : [
    {
     "captures" : {
      "1" : {
       "name" : "keyword.operator.concat.doublequoted.concatinator.bibtex"
      },
      "2" : {
       "name" : "punctuation.concat.doublequoted.open.bibtex"
      },
      "3" : {
       "name" : "context.text.concat.doublequoted.text.bibtex"
      },
      "4" : {
       "name" : "punctuation.concat.doublequoted.close.bibtex"
      }
     },
     "match" : "\u005Cs*(#)\u005Cs*\u005Cs*(\u0022)((?:\u005C\u005C\u0022|[^\u0022])*)(\u0022)\u005Cs*"
    },
    {
     "captures" : {
      "1" : {
       "name" : "keyword.operator.concat.singlequoted.concatinator.bibtex"
      },
      "2" : {
       "name" : "punctuation.concat.singlequoted.open.bibtex"
      },
      "3" : {
       "name" : "context.text.concat.singlequoted.text.bibtex"
      },
      "4" : {
       "name" : "punctuation.concat.singlequoted.close.bibtex"
      }
     },
     "match" : "\u005Cs*(#)\u005Cs*\u005Cs*(')((?:\u005C\u005C'|[^'])*)(')\u005Cs*"
    },
    {
     "captures" : {
      "1" : {
       "name" : "keyword.operator.concat.grouped.concatinator.bibtex"
      },
      "2" : {
       "name" : "keyword.operator.concat.grouped.open.bibtex"
      },
      "3" : {
       "name" : "context.text.concat.grouped.text.bibtex"
      },
      "4" : {
       "name" : "keyword.operator.concat.grouped.close.bibtex"
      }
     },
     "match" : "\u005Cs*(#)\u005Cs*\u005Cs*({)((?:\u005C\u005C{|\u005C\u005C}|[^\u005C{\u005C}])*)(})\u005Cs*"
    },
    {
     "captured" : {
      "1" : {
       "name" : "keyword.operator.concat.value.concatinator.bibtex"
      },
      "2" : {
       "name" : "context.text.concat.value.text.bibtex"
      }
     },
     "match" : "\u005Cs*(#)\u005Cs*\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*"
    }
   ]
  },
  "string_double" : {
   "captures" : {
    "1" : {
     "name" : "support.function.doublequoted.key.bibtex"
    },
    "2" : {
     "name" : "keyword.operator.doublequoted.equal.bibtex"
    },
    "3" : {
     "name" : "punctuation.doublequoted.open.bibtex"
    },
    "4" : {
     "name" : "context.text.doublequoted.text.bibtex"
    },
    "5" : {
     "name" : "punctuation.doublequoted.close.bibtex"
    }
   },
   "match" : "\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*\u005Cs*(=)\u005Cs*\u005Cs*(\u0022)((?:\u005C\u005C\u0022|[^\u0022])*)(\u0022)\u005Cs*"
  },
  "string_grouped" : {
   "captures" : {
    "1" : {
     "name" : "support.function.grouped.key.bibtex"
    },
    "2" : {
     "name" : "keyword.operator.grouped.equal.bibtex"
    },
    "3" : {
     "name" : "keyword.operator.grouped.open.bibtex"
    },
    "4" : {
     "name" : "context.text.grouped.text.bibtex"
    },
    "5" : {
     "name" : "keyword.operator.grouped.close.bibtex"
    }
   },
   "match" : "\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*\u005Cs*(=)\u005Cs*\u005Cs*({)((?:\u005C\u005C{|\u005C\u005C}|[^\u005C{\u005C}])*)(})\u005Cs*"
  },
  "string_single" : {
   "captures" : {
    "1" : {
     "name" : "support.function.singlequoted.key.bibtex"
    },
    "2" : {
     "name" : "keyword.operator.singlequoted.equal.bibtex"
    },
    "3" : {
     "name" : "punctuation.singlequoted.open.bibtex"
    },
    "4" : {
     "name" : "context.text.singlequoted.text.bibtex"
    },
    "5" : {
     "name" : "punctuation.singlequoted.close.bibtex"
    }
   },
   "match" : "\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*\u005Cs*(=)\u005Cs*\u005Cs*(')((?:\u005C\u005C'|[^'])*)(')\u005Cs*"
  },
  "string_value" : {
   "captures" : {
    "1" : {
     "name" : "support.function.value.key.bibtex"
    },
    "2" : {
     "name" : "keyword.operator.value.equal.bibtex"
    },
    "3" : {
     "name" : "context.text.value.text.bibtex"
    }
   },
   "match" : "\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*\u005Cs*(=)\u005Cs*\u005Cs*([a-zA-Z0-9\u005C_@:\u005C-]+)\u005Cs*"
  }
 },
 "scopeName" : "source.context.bibtex",
 "version" : "1.0.0"
}